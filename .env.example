# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Your app's public URL, no trailing slash
APP_URL=https://your-app.vercel.app

# Login for the website (pick a long password)
APP_PASSWORD=

# Random secrets — generate each with: openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=
MCP_SECRET=

# Plaid (dashboard.plaid.com → Developers → Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Optional: set to ${APP_URL}/oauth once it's added to Plaid's Allowed redirect URIs
PLAID_REDIRECT_URI=

# Supabase (Project → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
